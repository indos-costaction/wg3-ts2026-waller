* annex.backend=MD5E
**/.git* annex.largefiles=nothing
* annex.largefiles=nothing
*.webm annex.largefiles=anything
*.png annex.largefiles=anything
*.svg annex.largefiles=anything
*.tsv annex.largefiles=anything
# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true -diff
# QR codes are tiny: keep them in git rather than the annex, so the Pages
# build and the source archive (Zenodo) carry them without the annex remote
assets/qr-*.svg annex.largefiles=nothing
# Keep the data out of the source archives GitHub builds for releases,
# which is what Zenodo stores: only annex symlinks without content anyway
/ds000030-halfpipe export-ignore
/ds000117-halfpipe export-ignore
